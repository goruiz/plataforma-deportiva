# Copia este archivo a backend/.env y rellena cada valor. .env no se versiona: ahí viven los secretos del backend.
# Spring lo lee al arrancar (spring.config.import); una variable de entorno con el mismo nombre tiene prioridad.
DB_URL=jdbc:postgresql://localhost:5432/sports_platform
DB_USERNAME=sports_platform
DB_PASSWORD=cambia-esta-contrasena
# Al menos 32 caracteres aleatorios (256 bits). Cambiarlo cierra todas las sesiones.
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
# Cuenta que envia los correos (contrasena temporal, invitaciones, verificacion). Con Gmail es una contrasena de aplicacion.
MAIL_USERNAME=correo@ejemplo.com
MAIL_PASSWORD=contrasena-de-aplicacion
# Opcionales (por defecto smtp.gmail.com y 587):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
